<h2>イベント作成</h2>

<%= render '/admin/shared/error_messages', resource: @event %>

<%= form_with model: [:admin, @event] do |f| %>
    <div class="form-group">
        <%= f.label :name, "イベント名（必須）" %>
        <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :event_homepage_url, "イベントホームページURL（必須）" %>
        <%= f.url_field :event_homepage_url, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :event_start_at, "イベント開始日時（必須）" %>
        <%= f.datetime_field :event_start_at, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :event_end_at, "イベント終了日時（必須）" %>
        <%= f.datetime_field :event_end_at, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :url, "CfP募集ページURL" %>
        <%= f.url_field :url, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :cfp_start_at, "CfP募集開始日時" %>
        <%= f.datetime_field :cfp_start_at, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :cfp_end_at, "CfP募集終了日時" %>
        <%= f.datetime_field :cfp_end_at, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :image_url, "イメージURL" %>
        <%= f.url_field :image_url, class: "form-control" %>
    </div>        
    <%= f.submit%>
<% end %>