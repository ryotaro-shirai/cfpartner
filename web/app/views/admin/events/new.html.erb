<h2>イベント作成</h2>

<%= render '/admin/shared/error_messages', resource: @event %>

<%= form_with model: [:admin, @event] do |f| %>
    <div class="form-group">
        <%= f.label :name, "イベント名（必須）" %>
        <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :site_url, "イベントホームページURL（必須）" %>
        <%= f.url_field :site_url, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :thumbnail_url, "サムネイル画像URL" %>
        <%= f.url_field :thumbnail_url, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :start_at, "イベント開始日時（必須）" %>
        <%= f.datetime_field :start_at, value: Time.current.change(sec: 0).strftime('%Y-%m-%dT%H:%M:%S'), step: 1, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :end_at, "イベント終了日時（必須）" %>
        <%= f.datetime_field :end_at, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :status, "イベントステータス" %>
        <%= f.select :status, Event.statuses.keys, class: "form-control" %>
    </div>
    <%= f.submit%>
<% end %>