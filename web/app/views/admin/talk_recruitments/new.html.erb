<h2>CfP作成</h2>

<%= render '/admin/shared/error_messages', resource: @talk_recruitment %>

<%= form_with model: [:admin, @talk_recruitment] do |f| %>
    <div class="form-group">
        <%= f.label :title, "CfP名（必須）" %>
        <%= f.text_field :title, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :site_url, "CfP募集URL" %>
        <%= f.url_field :site_url, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :start_at, "CfP募集開始日時" %>
        <%= f.datetime_field :start_at, value: Time.current.change(sec: 0).strftime('%Y-%m-%dT%H:%M:%S'), step: 60, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :end_at, "CfP終了日時" %>
        <%= f.datetime_field :end_at, value: Time.current.change(sec: 0).strftime('%Y-%m-%dT%H:%M:%S'), step: 60, class: "form-control" %>
    </div>
    <div class="form-group">
        <%= f.label :event, "イベント" %>
        <%= f.collection_select :event_id, @events, :id, :name, class: "form-control" %>
    </div>
    <%= f.submit%>
<% end %>