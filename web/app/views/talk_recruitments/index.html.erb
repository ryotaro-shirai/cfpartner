<div class="page">
  <header class="page-header">
    <p class="eyebrow">CfP Tracker</p>
    <h1 class="page-title">CfPartner</h1>
    <p class="page-description">
      カンファレンスのCfP期限をひと目で把握できるシンプルな一覧です。
    </p>
  </header>

  <section class="talk-recruitments-section">
    <div class="talk-recruitments-grid">
      <% @talk_recruitments.each do |talk_recruitment| %>
        <% badge = status_badge(talk_recruitment) %>
        <% deadline = deadline_chip(talk_recruitment) %>
          <article class="talk-recruitment-card">
            <%= link_to talk_recruitment.event.site_url, target: "_blank", rel: "noopener", class: "talk-recruitment-card-link" do %>
              <% if talk_recruitment.event.thumbnail_url.present? %>
                <div class="talk-recruitment-thumb">
                  <%= image_tag talk_recruitment.event.thumbnail_url, alt: "#{talk_recruitment.event.name}のイメージ" %>
                </div>
              <% else %>
                <div class="talk-recruitment-thumb placeholder">No image</div>
              <% end %>
            <% end %>

            <div class="talk-recruitment-body">
              <div class="talk-recruitment-meta">
                <span class="status-badge <%= badge[:tone] %>"><%= badge[:label] %></span>
                <% if talk_recruitment.end_at.present? %>
                  <span class="deadline-chip <%= deadline[:tone] %>">
                    <svg class="deadline-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 8v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="deadline-text"><%= deadline[:label] %></span>
                  </span>
                <% end %>
              </div>

              <h3 class="talk-recruitment-title"><%= talk_recruitment.title %></h3>

              <div class="talk-recruitment-timeline" aria-label="日程情報">
                <div class="timeline-row">
                  <span class="timeline-label timeline-label-deadline">
                    <svg class="timeline-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 8v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    提出締め切り
                  </span>
                  <span class="timeline-value"><%= deadline_date(talk_recruitment) %></span>
                </div>
                <div class="timeline-row">
                  <span class="timeline-label timeline-label-event">
                    <svg class="timeline-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M8 2v3M16 2v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M3 9h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M6 5h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    </svg>
                    イベント開催
                  </span>
                  <span class="timeline-value"><%= event_date(talk_recruitment.event) %></span>
                </div>
              </div>

              <div class="talk-recruitment-actions">
                <% if talk_recruitment.site_url.present? %>
                  <% case talk_recruitment.status %>
                  <% when "published_information", "now_on_call" %>
                    <%= link_to talk_recruitment.site_url, target: "_blank", rel: "noopener", class: "talk-recruitment-button" do %>
                      Submit Proposal
                    <% end %>
                  <% when "finished_call" %>
                    <%= link_to talk_recruitment.site_url, target: "_blank", rel: "noopener", class: "talk-recruitment-button talk-recruitment-button-closed" do %>
                      CfP Closed
                    <% end %>
                  <% end %>
                <% end %>

                <% if talk_recruitment.event.site_url.present? %>
                  <%= link_to talk_recruitment.event.site_url, target: "_blank", rel: "noopener", class: "talk-recruitment-button talk-recruitment-button-secondary" do %>
                    Event Page
                  <% end %>
                <% end %>
              </div>
            </div>
          </article>
      <% end %>

      <% if @talk_recruitments.empty? %>
        <div class="empty-state">
          <p>まだイベントが登録されていません。</p>
          <p>左上の管理画面から追加してください。</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
